+/// Local patch (diagnostics): the time between the title's frame starts,
+/// logged every 10 s as percentiles ("FRAMETIMES"), to tell a steady frame
+/// from one with spikes.
+#[cfg(feature = "diagnostics")]
+fn frame_times() {
+    static STATE: std::sync::Mutex<Option<(Instant, Instant, Vec<u32>)>> = std::sync::Mutex::new(None);
+    let now = Instant::now();
+    let mut state = STATE.lock().unwrap_or_else(|e| e.into_inner());
+    let (last, logged, times) = state.get_or_insert_with(|| (now, now, Vec::with_capacity(1024)));
+    times.push(now.duration_since(*last).as_micros().min(u128::from(u32::MAX)) as u32);
+    *last = now;
+    if now.duration_since(*logged) >= Duration::from_secs(10) && times.len() > 4 {
+        let mut v = std::mem::take(times);
+        *logged = now;
+        drop(state);
+        v.sort_unstable();
+        let at = |p: f64| f64::from(v[((v.len() - 1) as f64 * p) as usize]) / 1000.0;
+        let over = |ms: u32| v.iter().filter(|&&t| t > ms * 1000).count();
+        let mean = v.iter().map(|&t| f64::from(t)).sum::<f64>() / v.len() as f64 / 1000.0;
+        tracing::info!(
+            "FRAMETIMES {} frames: mean {:.1} ms, p50 {:.1}, p90 {:.1}, p99 {:.1}, max {:.1}; over 34 ms {}, over 50 ms {}, over 100 ms {}",
+            v.len(),
+            mean,
+            at(0.5),
+            at(0.9),
+            at(0.99),
+            at(1.0),
+            over(34),
+            over(50),
+            over(100)
+        );
+    }
+}
