+                let cut = found.rfind('_').filter(|&k| found.len() - k - 1 == 8 && found[k + 1..].bytes().all(|b| b.is_ascii_hexdigit()));
+                parts.push(match cut {
+                    Some(k) => found[..k].to_owned(),
+                    None => found,
