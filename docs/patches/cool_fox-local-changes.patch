+    static COUNTS: Mutex<Option<HashMap<Arc<str>, u64>>> = Mutex::new(None);
+    static LAST: AtomicU64 = AtomicU64::new(0);
+    static FRAME0: AtomicU64 = AtomicU64::new(0);
+    let key = std::ptr::from_ref(p) as usize;
